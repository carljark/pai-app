{
  // El backend se ejecuta con tsx (sin paso de build): tsc solo hace typecheck.
  "compilerOptions": {
    // Entorno: Node 22 + ESM. tsx resuelve imports relativos sin extensión,
    // así que se usa la resolución "bundler" en lugar de "nodenext".
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "noEmit": true,

    // Typecheck estricto
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Módulos
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  // Migraciones antiguas congeladas: no se editan (ver CLAUDE.md)
  "exclude": ["src/migrations/legacy"]
}
